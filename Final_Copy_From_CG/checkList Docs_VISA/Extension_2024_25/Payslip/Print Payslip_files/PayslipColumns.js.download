// JScript File
var isIE = (navigator.appName.indexOf("Microsoft Internet Explorer") != -1);
var pnlAllowancesDataID;
var pnlDeductionsDataID;
var pnlBalancesDataID;
var pnlMessageID;
var dvAllColPrtPayslipID;
var dvDedColPrtPayslipID;
var dvBalColPrtPayslipID;
var pnlBenefitsDataID;
var pnlVolDedDataID;
var pnlEarningsDataID;
var dvBenColPrtPayslipID;
var dvVolBenColPrtPayslipID;
var dvErnsColPrtPayslipID;
var dvTotalAllID;
var dvTotalDedID;
var dvNetPayID;

function SetEmployeePayslipColumnDepths()
{
    
    var maxHeight;
    var i;

    //#163446: ISS OPD - Able to view my existing Bespoke Payslip and the new standard payslip form March 2020 in OPD
    var x = document.getElementsByClassName("DataArea");    
    maxHeight = 0;
    i = 0;
    for (i = 0; i < x.length; i++) {
        if (x[i].offsetHeight > maxHeight) {
            maxHeight = x[i].offsetHeight;
        }            
    }

    for (i = 0; i < x.length; i++) {
        x[i].style.height = maxHeight + 90 + "px";
    }

    var y = document.getElementsByClassName("DataAreaPrtPayslip");
    if (y.length > 0) {
        maxHeight = 0;
        i = 0;
        for (i = 0; i < y.length; i++) {
            if (y[i].offsetHeight > maxHeight) {
                maxHeight = y[i].offsetHeight;
            }
        }

        for (i = 0; i < y.length; i++) {
            y[i].style.height = maxHeight + 10 + "px";
        }
    }
 
    var GEExtra = document.getElementsByClassName("DataAreaGEExtra");
    var cntGEExtra;
    maxHeight = 0;
    for (cntGEExtra = 0; cntGEExtra < GEExtra.length; cntGEExtra++) {
        if (GEExtra[cntGEExtra].offsetHeight > maxHeight) {
            maxHeight = GEExtra[cntGEExtra].offsetHeight;
        }
    }

    for (cntGEExtra = 0; cntGEExtra < GEExtra.length; cntGEExtra++) {
        GEExtra[cntGEExtra].style.height = maxHeight + 90 + "px";
    }

    var PrtGEExtra = document.getElementsByClassName("DataAreaPrtGEExtra");
    if (PrtGEExtra.length > 0) {
        maxHeight = 0;
        i = 0;
        for (i = 0; i < PrtGEExtra.length; i++) {
            if (PrtGEExtra[i].offsetHeight > maxHeight) {
                maxHeight = PrtGEExtra[i].offsetHeight;
            }
        }

        for (i = 0; i < PrtGEExtra.length; i++) {
            PrtGEExtra[i].style.height = maxHeight + 10 + "px";
        }
    }
}

function RecalcHeight()
{

    var pnlAllowancesData;
    var pnlDeductionsData;
    var pnlBalancesData;
    var payAllowancesHeight;
    var deductionsHeight;
    var balancesHeight;
    var maxHeight;
    var pnlMessages;
    var dvAllColPrtPayslip;
    var dvDedColPrtPayslip;
    var dvBalColPrtPayslip;

        pnlAllowancesData = document.getElementById(pnlAllowancesDataID);
        pnlDeductionsData = document.getElementById(pnlDeductionsDataID);
        pnlBalancesData = document.getElementById(pnlBalancesDataID);

        pnlAllowancesData.style.height = 'auto';
        pnlDeductionsData.style.height = 'auto';
        pnlBalancesData.style.height = 'auto';

            payAllowancesHeight = document.all[pnlAllowancesDataID].offsetHeight;
            deductionsHeight = document.all[pnlDeductionsDataID].offsetHeight;
            balancesHeight = document.all[pnlBalancesDataID].offsetHeight;
        
        if (!isIE)
        {
            payAllowancesHeight = document.getElementById(pnlAllowancesDataID).offsetHeight;
            deductionsHeight = document.getElementById(pnlDeductionsDataID).offsetHeight;
            balancesHeight = document.getElementById(pnlBalancesDataID).offsetHeight;            
        }

        maxHeight = 0;
        maxHeight = Math.max(maxHeight, payAllowancesHeight);
        maxHeight = Math.max(maxHeight, deductionsHeight);
        maxHeight = Math.max(maxHeight, balancesHeight);
        maxHeight = parseInt(maxHeight) + 20;
        
        pnlAllowancesData.style.height = maxHeight + 'px';
        pnlDeductionsData.style.height = maxHeight + 'px';
        pnlBalancesData.style.height = maxHeight + 'px';
        
        if (!isIE)
        {
//            pnlMessages.style.top = 60 + 'px';
            
            dvAllColPrtPayslip = document.getElementById(dvAllColPrtPayslipID);
            dvDedColPrtPayslip = document.getElementById(dvDedColPrtPayslipID);
            dvBalColPrtPayslip = document.getElementById(dvBalColPrtPayslipID);
            
            if (dvAllColPrtPayslip != null && dvDedColPrtPayslip != null && dvBalColPrtPayslip != null)
            {
                dvAllColPrtPayslip.style.width = '206px';
                dvDedColPrtPayslip.style.width = '207px';
                dvBalColPrtPayslip.style.width = '207px';
            }
        }
}